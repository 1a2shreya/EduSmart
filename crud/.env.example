# ==============================================================================
# EduSmart Environment Configuration Example
# Copy this file to .env in this folder (or root) and fill in your real credentials.
# DO NOT COMMIT THE ACTUAL .env FILE TO GITHUB!
# ==============================================================================

# Django Security
SECRET_KEY=your_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Google Gemini API (For Note Summarization, AI Quizzes, Adaptive Plans)
GEMINI_API_KEY=your_gemini_api_key_here

# Email Configuration (Used for User Registration OTP & Password Reset)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_specific_password_here
DEFAULT_FROM_EMAIL=EduSmart <noreply@edusmart.com>
